# --- TKBK Cloud Agents: orchestrator ---------------------------------------
# HMAC secret for the bot/site/admin side of the API (same scheme as the bot's EA_INTERNAL_SECRET).
# >= 32 chars. Generate: openssl rand -hex 32. The IDE does NOT use it (Bearer cr_… instead).
AGENTS_INTERNAL_SECRET=

# Public URL (behind Caddy) used in result links; AGENTS_DOMAIN is for Caddy's TLS.
PUBLIC_BASE_URL=https://agents.tkbk.online
AGENTS_DOMAIN=agents.tkbk.online

# --- Licenses (who may run cloud agents) ------------------------------------
# site = ask https://tkbk.online/api/license/check (Pro / Teams / Teams+ have cloud_agents);
# stub = LOCAL ONLY: every cr_ key is treated as STUB_PLAN.
LICENSE_MODE=site
LICENSE_CHECK_URL=https://tkbk.online/api/license/check
# Ed25519 public key of the site (base64, 32 bytes) — when set, answers are signature-checked.
LICENSE_PUBLIC_KEY=
LICENSE_CACHE_SECONDS=600
STUB_PLAN=pro
# Parallel tasks per client by plan, and for unknown plans.
CONCURRENT_PER_PLAN=pro:3,team:5,team_plus:10
CONCURRENT_DEFAULT=3

# --- TKBK gateway (client keys cr_… are sent per task, never stored here) ---
TKBK_ANTHROPIC_BASE_URL=https://api.tkbk.online
TKBK_OPENAI_BASE_URL=https://api.tkbk.online/openai/v1
TKBK_MODELS_URL=https://api.tkbk.online/v1/models
DEFAULT_MODEL=claude-sonnet-5
# 1 = bot/site flows also verify the key against TKBK_MODELS_URL before queueing.
TKBK_KEY_CHECK=1

# --- Sandbox (one container per task) ---------------------------------------
SANDBOX_IMAGE=ghcr.io/openhands/agent-server:1.55.0-python
SANDBOX_MEMORY=4g
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=512
SANDBOX_EGRESS_PROXY=http://tkbk-agents-egress:3128
# Workspaces come from the compose volume `tasks` (TASKS_VOLUME is set by docker-compose.yml).
# For a bind-mount layout instead, unset TASKS_VOLUME and make TASKS_ROOT identical on host and container.

# --- Limits -------------------------------------------------------------------
MAX_CONCURRENT_TASKS=10
DEFAULT_MAX_MINUTES=60
MAX_MAX_MINUTES=120
DEFAULT_MAX_ITERATIONS=100
# 0 = off. Extra safety cap on billed minutes per key per calendar month (plans already cap by hours).
MONTHLY_MINUTES_CAP_PER_KEY=0
UPLOAD_MAX_MB=200
# Patches/archives/event logs of finished tasks are deleted after this many days (0 = keep).
RESULTS_TTL_DAYS=7

# Git identity for commits the orchestrator makes on behalf of the agent.
GIT_AUTHOR_NAME=TKBK Cloud Agent
GIT_AUTHOR_EMAIL=agents@tkbk.online
