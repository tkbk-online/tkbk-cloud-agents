# --- TKBK Cloud Agents: orchestrator ---------------------------------------
# HMAC secret for the internal REST API (same scheme as the bot's EA_INTERNAL_SECRET).
# >= 32 chars. Generate: openssl rand -hex 32
AGENTS_INTERNAL_SECRET=

# Public URL (behind Caddy) used in result links.
PUBLIC_BASE_URL=https://agents.tkbk.online

# TKBK gateway endpoints (client cr_ keys are sent per task, never stored here).
TKBK_ANTHROPIC_BASE_URL=https://api.tkbk.online
TKBK_OPENAI_BASE_URL=https://api.tkbk.online/openai/v1
TKBK_MODELS_URL=https://api.tkbk.online/v1/models
DEFAULT_MODEL=claude-sonnet-5
# 1 = check the client's key against TKBK_MODELS_URL before queueing a task.
TKBK_KEY_CHECK=1

# Sandbox (one container per task).
SANDBOX_IMAGE=ghcr.io/openhands/agent-server:1.55.0-python
SANDBOX_MEMORY=4g
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=512
SANDBOX_EGRESS_PROXY=http://tkbk-agents-egress:3128
# Host path that is bind-mounted into BOTH the orchestrator and every sandbox.
# Must be the same absolute path on the host and inside the orchestrator container.
TASKS_ROOT=/var/lib/tkbk-agents/tasks

# Limits.
MAX_CONCURRENT_TASKS=3
DEFAULT_MAX_MINUTES=30
MAX_MAX_MINUTES=120
DEFAULT_MAX_ITERATIONS=100
# 0 = off. Safety cap on billed minutes per key per calendar month.
MONTHLY_MINUTES_CAP_PER_KEY=0

# Git identity for commits the orchestrator makes on behalf of the agent.
GIT_AUTHOR_NAME=TKBK Cloud Agent
GIT_AUTHOR_EMAIL=agents@tkbk.online
